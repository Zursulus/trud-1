# Copy outside the public document root. This file is not loaded automatically.
# For systemd use EnvironmentFile; never commit the actual values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_ORIGINS=
DJANGO_TRUST_PROXY=0
PGDATABASE=trud_site
PGUSER=trud_site
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# Temporary forum/email login: explicit opt-in in production.
TRUD_RESIDENT_EMAIL_LOGIN_ENABLED=0
TRUD_FORUM_ENABLED=0
TRUD_FORUM_PUBLIC_READ=0
TRUD_FORUM_MESSAGES_PER_MINUTE=3
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=webmaster@localhost
